# Web / UDP
WEB_PORT=8080
UDP_PORT=12730
UDP_FILTER_IP=
AUTO_START=true

# MCAP 双档归档
MCAP_ENABLED=true
MCAP_DEDUP_ENABLED=true
MCAP_HOURLY_HOST_DIR=/home/user/data/test-data/plc-data/simple-hourly
MCAP_SHORT_HOST_DIR=/home/user/data/test-data/plc-data/simple-short
MCAP_HOURLY_ROTATION_SECONDS=3600
MCAP_SHORT_ROTATION_SECONDS=600
MCAP_HOURLY_RETENTION_DAYS=30
MCAP_SHORT_RETENTION_DAYS=1
MCAP_LIST_LIMIT=10
# 归档文件内不同时间戳 ≤ 此值时，文件名追加 -empty（如 20250916_141258-20250916_151258-empty.mcap）
MCAP_EMPTY_MAX_UNIQUE_TIMESTAMPS=2

# UDP 通路超时（秒），超时后停止采集与 MCAP 录制
HEALTH_TIMEOUT=5

# Foxglove 3D 场景（/crane727r/spreader/scene）
SCENE_FRAME_ID=ground
SCENE_TROLLEY_FIXED_HEIGHT_M=30
SCENE_GROUND_SIZE_M=80
SCENE_MARKER_SIZE_M=2.0
SCENE_GROUND_ALPHA=0.08



