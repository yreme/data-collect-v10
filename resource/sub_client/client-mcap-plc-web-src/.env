# Web / UDP
MCAP_WEB_PORT=18881
UDP_PORT=12730
UDP_FILTER_IP=
AUTO_START=true

# PLC 从共享内存读取（由 plc-data-collect 写入）
PLC_SHM_SEGMENT=plc_crane727r
PLC_SHM_PREFIX=plc_
PLC_SHM_DEVICE=crane727r
MCAP_ENABLED=true
MCAP_DEDUP_ENABLED=true
MCAP_HOURLY_DIR=/data/mcap/hourly
MCAP_SHORT_DIR=/data/mcap/short
MCAP_HOURLY_HOST_DIR=/home/user/data/test-data/gige-lidar-imu-plc-data/simple-hourly
MCAP_SHORT_HOST_DIR=/home/user/data/test-data/gige-lidar-imu-plc-data/simple-short
MCAP_HOURLY_ROTATION_SECONDS=3600
MCAP_SHORT_ROTATION_SECONDS=600
MCAP_HOURLY_RETENTION_DAYS=30
MCAP_SHORT_RETENTION_DAYS=1
MCAP_LIST_LIMIT=10
MCAP_EMPTY_MAX_UNIQUE_TIMESTAMPS=2
MCAP_CAMERA_ENCODING=video
MCAP_VIDEO_CODEC=libx264
MCAP_VIDEO_PRESET=ultrafast
MCAP_VIDEO_FPS=20
MCAP_VIDEO_GOP=20
MCAP_SENSOR_APPEND_ON_UPDATE=false

# Web 配置
MCAP_WEB_CONFIG=/app/configs/client_mcap.yaml
MCAP_WEB_OUTPUT_DIR=/data/mcap
MCAP_WEB_DEFAULT_PREFIX=multimodal
MCAP_WEB_IMU_SHM_PREFIX=imu_
MCAP_WEB_IMU_PERSIST_DIR=/data/mcap/imu_motion

# UDP 通路超时（秒）
HEALTH_TIMEOUT=5

# Foxglove 3D 场景
SCENE_FRAME_ID=ground
SCENE_TROLLEY_FIXED_HEIGHT_M=30
SCENE_GROUND_SIZE_M=80
SCENE_MARKER_SIZE_M=2.0
SCENE_GROUND_ALPHA=0.08
