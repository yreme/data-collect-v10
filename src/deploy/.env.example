# 复制为 .env 后修改：cp .env.example .env
# --- 可复用基础镜像（见 设计/可复用的docker资源.md）---
VERSION=v7.1.0
REGISTRY=registry.us-west-1.aliyuncs.com/waytous_docker/0-tmp-image
GIGE_IMAGE=${REGISTRY}:server-gige-sync-v7.1.0-x64
LIDAR_IMAGE=${REGISTRY}:server-lidar-sync-v7.1.0-x64
IMU_IMAGE=${REGISTRY}:server-imu-sync-v7.1.0-x64
FOXGLOVE_IMAGE=${REGISTRY}:client-foxglove-v7.1.0-x64
MCAP_IMAGE=${REGISTRY}:client-mcap-web-v7.1.0-x64

# --- sensorhub 自身镜像 tag ---
SENSORHUB_TAG=dev
ZENOHD_IMAGE=eclipse/zenoh:1.10.1
PIP_INDEX_URL=https://pypi.org/simple

# --- 运行参数 ---
SENSORHUB_PREFIX=rig
SENSORS_CONFIG=sensors.yaml
SENSORHUB_CONFIG_DIR=../configs
SENSORHUB_DATA_DIR=./data
# 服务器 A 用 zenohd.json5；服务器 D 用 zenohd.server-d.json5（连接 A）
ZENOHD_CONFIG=zenohd.json5
ZENOH_CONNECT=tcp/127.0.0.1:7447
ZENOH_SHM=1
CONSOLE_PORT=18100
FOXGLOVE_PORT=8765
PREVIEW_HZ=1
TZ=Asia/Shanghai
